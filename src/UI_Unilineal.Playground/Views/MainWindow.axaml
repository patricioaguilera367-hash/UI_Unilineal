<Window
    x:Class="UI_Unilineal.Playground.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1280"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    Title="UI_Unilineal — Playground">

  <Grid RowDefinitions="Auto,*">

    <Border Padding="16">
      <StackPanel>
        <TextBlock
            FontSize="20"
            FontWeight="SemiBold"
            Text="UI_Unilineal" />

        <TextBlock
            Margin="0,4,0,0"
            Opacity="0.7"
            Text="Playground desacoplado — Single Line Diagram Engine" />
      </StackPanel>
    </Border>

    <Border
        Grid.Row="1"
        Margin="16"
        BorderThickness="1"
        CornerRadius="6">

      <Grid>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Opacity="0.6"
            Text="El canvas del unifilar se implementará aquí." />
      </Grid>

    </Border>

  </Grid>

</Window>
